// Cloudflare Workers configuration.
//
// EIGA is a static export — `next.config.ts` sets `output: "export"`, so
// `npm run build` writes finished HTML, CSS and JS into `out/` and there is no
// server, no route handler and no environment to configure. This file says
// exactly that: assets and nothing else.
//
// It exists because of what happens without it. `wrangler deploy` runs an
// auto-config step when it finds no configuration, and on a Next.js repo it
// guesses a server-rendered app: it reported the output directory as `.next`,
// auto-answered "yes" to its own setup prompt in the non-interactive builder,
// and ran `@opennextjs/cloudflare migrate` — 262 packages, a rewritten
// `next.config.ts`, an `open-next.config.ts`, a `.dev.vars`, and a config with
// `observability.enabled: true`. The build then failed looking for
// `.next/standalone/.next/server/pages-manifest.json`, a server artifact a
// static export never emits.
//
// So this file is not boilerplate. Its presence is the fix: auto-config only
// runs when there is no config to read.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eiga",
  "compatibility_date": "2026-08-20",

  // No `main`. A Worker script is the one thing this project must not acquire —
  // there is nothing for it to do that the browser is not already doing, and a
  // request reaching server code is a request that could log a film title.
  "assets": {
    "directory": "./out",

    // The export writes `404.html`; this is what serves it. Deliberately not
    // "single-page-application", which would answer every unknown path with
    // `index.html` and silently boot the atlas at a URL that means nothing.
    "not_found_handling": "404-page",
  },

  // Off, explicitly, because the tooling's default is on.
  //
  // Workers Logs records request metadata host-side. With no `main` there is no
  // invocation to record, so this changes nothing today — it is here so that
  // adding a Worker later cannot quietly switch it on. EIGA's promise is that
  // nothing leaves the browser, and that promise has to hold at the edge too.
  "observability": {
    "enabled": false,
  },
}
